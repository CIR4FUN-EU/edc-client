# construct-x testbed config. Used automatically when FLAVOR=construct_x.
# PROVIDER_PROTOCOL/CONSUMER_PROTOCOL are docker-internal DSP addresses
# (the connectors run in docker); API keys are required.

PROVIDER_MANAGEMENT=http://localhost:39010/management
PROVIDER_PROTOCOL=http://provider-controlplane:9020/dsp
PROVIDER_ID=did:web:provider-idhub:user:provider
PROVIDER_API_KEY=prov-management-api-key

CONSUMER_MANAGEMENT=http://localhost:29010/management
CONSUMER_PROTOCOL=http://consumer-controlplane:9020/dsp
CONSUMER_ID=did:web:consumer-idhub:user:consumer
CONSUMER_API_KEY=cons-management-api-key

# Only used for PUSH transfers
PUSH_DESTINATION_URL=http://localhost:4000
